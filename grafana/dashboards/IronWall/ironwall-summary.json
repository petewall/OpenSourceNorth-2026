                "content": "# IronWall\nTracking every rep, every set, every workout.",
                "mode": "markdown"
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT COUNT(*) as \"Workouts\" FROM workouts WHERE user_id = (SELECT id FROM users WHERE username = 'pete')"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 2,
          "links": [],
          "title": "Workouts",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "blue",
                    "mode": "fixed"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT CASE '${unit}' WHEN 'lbs' THEN ROUND((SUM(s.weight_kg * s.reps) * 2.20462)::numeric, 0) ELSE ROUND((SUM(s.weight_kg * s.reps))::numeric, 0) END as \"Volume (${unit})\" FROM sets s JOIN workout_exercises we ON we.id = s.workout_exercise_id JOIN workouts w ON w.id = we.workout_id WHERE w.user_id = (SELECT id FROM users WHERE username = 'pete') AND s.set_type != 'warmup' AND s.weight_kg IS NOT NULL AND s.reps IS NOT NULL"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 3,
          "links": [],
          "title": "Total Volume",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "orange",
                    "mode": "fixed"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT w.id::text as \"id\", to_char(w.started_at AT TIME ZONE 'America/Chicago', 'YYYY-MM-DD') as \"Date\", STRING_AGG(DISTINCT e.name, ', ' ORDER BY e.name) as \"Exercises\", CASE WHEN w.ended_at IS NOT NULL THEN ROUND(EXTRACT(EPOCH FROM (w.ended_at - w.started_at))/60)::text || ' min' ELSE 'In progress' END as \"Duration\", CASE '${unit}' WHEN 'lbs' THEN ROUND((COALESCE(SUM(s.weight_kg * s.reps), 0) * 2.20462)::numeric, 1) ELSE ROUND((COALESCE(SUM(s.weight_kg * s.reps), 0))::numeric, 1) END as \"Volume (${unit})\" FROM workouts w JOIN workout_exercises we ON we.workout_id = w.id JOIN exercises e ON e.id = we.exercise_id LEFT JOIN sets s ON s.workout_exercise_id = we.id AND s.set_type != 'warmup' AND s.weight_kg IS NOT NULL AND s.reps IS NOT NULL WHERE w.user_id = (SELECT id FROM users WHERE username = 'pete') GROUP BY w.id, w.started_at, w.ended_at ORDER BY w.started_at DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 4,
          "links": [],
          "title": "Workouts",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "footer": {
                      "reducers": []
