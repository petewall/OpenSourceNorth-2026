            "version": "13.1.0-24910154156"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT w.id::text as \"id\", to_char(w.started_at AT TIME ZONE 'America/Chicago', 'YYYY-MM-DD') as \"Date\", STRING_AGG(DISTINCT e.name, ', ' ORDER BY e.name) as \"Exercises\", CASE WHEN w.ended_at IS NOT NULL THEN ROUND(EXTRACT(EPOCH FROM (w.ended_at - w.started_at))/60)::text || ' min' ELSE 'In progress' END as \"Duration\", CASE '${unit}' WHEN 'lbs' THEN ROUND((COALESCE(SUM(s.weight_kg * s.reps), 0) * 2.20462)::numeric, 1) ELSE ROUND((COALESCE(SUM(s.weight_kg * s.reps), 0))::numeric, 1) END as \"Volume (${unit})\" FROM workouts w JOIN workout_exercises we ON we.workout_id = w.id JOIN exercises e ON e.id = we.exercise_id LEFT JOIN sets s ON s.workout_exercise_id = we.id AND s.set_type != 'warmup' AND s.weight_kg IS NOT NULL AND s.reps IS NOT NULL WHERE w.user_id = (SELECT id FROM users WHERE username = 'pete') GROUP BY w.id, w.started_at, w.ended_at ORDER BY w.started_at DESC",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 4,
          "links": [],
          "title": "",
          "vizConfig": {
