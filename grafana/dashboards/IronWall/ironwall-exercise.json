                      "spec": {
                        "format": "time_series",
                        "rawSql": "SELECT w.started_at as time, CASE '${unit}' WHEN 'lbs' THEN ROUND((SUM(s.weight_kg * s.reps) * 2.20462)::numeric, 1) ELSE ROUND((SUM(s.weight_kg * s.reps))::numeric, 1) END as \"Volume (${unit})\" FROM sets s JOIN workout_exercises we ON we.id = s.workout_exercise_id JOIN workouts w ON w.id = we.workout_id JOIN exercises e ON e.id = we.exercise_id WHERE e.name = '${exercise}' AND s.set_type != 'warmup' AND s.weight_kg IS NOT NULL AND s.reps IS NOT NULL AND $__timeFilter(w.started_at) GROUP BY w.started_at ORDER BY w.started_at"
