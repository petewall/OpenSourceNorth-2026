      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": false,
          "current": {
            "text": "",
            "value": ""
          },
          "datasource": {
            "name": "${datasource}"
          },
          "hide": "dontHide",
          "includeAll": false,
          "label": "Workout",
          "multi": false,
          "name": "workout",
          "options": [],
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "postgres",
            "kind": "DataQuery",
            "spec": {
              "format": "table",
              "rawSql": "SELECT w.id::text as __value, to_char(w.started_at AT TIME ZONE 'America/Chicago', 'YYYY-MM-DD HH24:MI') || ' \u2014 ' || STRING_AGG(DISTINCT e.name, ', ') as __text FROM workouts w JOIN workout_exercises we ON we.workout_id = w.id JOIN exercises e ON e.id = we.exercise_id WHERE w.user_id = (SELECT id FROM users WHERE username = 'pete') GROUP BY w.id, w.started_at ORDER BY w.started_at DESC"
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "skipUrlSync": false,
          "sort": "disabled"
        }
      },
      {
        "kind": "QueryVariable",
        "spec": {
          "allowCustomValue": false,
          "current": {
            "text": "All",
            "value": "$__all"
          },
          "datasource": {
            "name": "${datasource}"
          },
          "hide": "hideVariable",
          "includeAll": true,
          "label": "Exercise",
          "multi": true,
          "name": "workout_exercises",
          "options": [],
          "query": {
            "datasource": {
              "name": "${datasource}"
            },
            "group": "postgres",
            "kind": "DataQuery",
            "spec": {
              "format": "table",
              "rawSql": "SELECT e.name AS __text, e.name AS __value FROM workout_exercises we JOIN exercises e ON e.id = we.exercise_id WHERE we.workout_id::text = '${workout}' ORDER BY we.position"
            },
            "version": "v0"
          },
          "refresh": "onDashboardLoad",
          "regex": "",
          "skipUrlSync": false,
          "sort": "disabled"
        }
