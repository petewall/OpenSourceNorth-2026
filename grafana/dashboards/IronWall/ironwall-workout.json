{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "ironwall-workout"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT to_char(w.started_at AT TIME ZONE 'America/Chicago', 'YYYY-MM-DD') as \"Date\", to_char(w.started_at AT TIME ZONE 'America/Chicago', 'HH24:MI') as \"Start\", to_char(w.ended_at AT TIME ZONE 'America/Chicago', 'HH24:MI') as \"End\", CASE WHEN w.ended_at IS NOT NULL THEN ROUND(EXTRACT(EPOCH FROM (w.ended_at - w.started_at))/60)::text || ' min' ELSE 'In progress' END as \"Duration\" FROM workouts w WHERE w.id::text = '${workout}'"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "Workout",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false,
                    "wrapHeaderText": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": []
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT CASE '${unit}' WHEN 'lbs' THEN ROUND((SUM(s.weight_kg * s.reps) * 2.20462)::numeric, 1) ELSE ROUND((SUM(s.weight_kg * s.reps))::numeric, 1) END as \"Volume (${unit})\" FROM sets s JOIN workout_exercises we ON we.id = s.workout_exercise_id WHERE we.workout_id::text = '${workout}' AND s.set_type != 'warmup' AND s.weight_kg IS NOT NULL AND s.reps IS NOT NULL"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 2,
          "links": [],
          "title": "Total Volume",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "fixedColor": "orange",
                    "mode": "fixed"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "short"
                },
                "overrides": []
              },
              "options": {
                "colorMode": "background",
                "graphMode": "none",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 3,
          "links": [],
          "title": "",
          "transparent": true,
          "vizConfig": {
            "group": "text",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "📷 Image placeholder",
                "mode": "markdown"
              }
            },
            "version": "13.1.0-24878921911"
          }
        }
      },
      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "${datasource}"
                      },
                      "group": "postgres",
                      "kind": "DataQuery",
                      "spec": {
                        "format": "table",
                        "rawSql": "SELECT s.set_number AS \"Set\", s.reps AS \"Reps\", CASE WHEN s.partials > 0 THEN s.partials::text ELSE '' END AS \"Partials\", CASE '${unit}' WHEN 'lbs' THEN ROUND((s.weight_kg * 2.20462)::numeric, 1) ELSE ROUND(s.weight_kg::numeric, 2) END AS \"Weight (${unit})\", s.set_type AS \"Type\" FROM workout_exercises we JOIN exercises e ON e.id = we.exercise_id JOIN sets s ON s.workout_exercise_id = we.id WHERE we.workout_id::text = '${workout}' AND e.name = '${workout_exercises}' ORDER BY s.set_number"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 4,
          "links": [],
          "title": "Sets",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "thresholds"
                  },
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "filterable": true,
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false,
                    "wrapHeaderText": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": []
              }
            },
            "version": "13.1.0-24878921911"
          }
